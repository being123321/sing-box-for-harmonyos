{
  app: {
    products: [
      {
        name: 'default',
        compileSdkVersion: '26.0.1',
        targetSdkVersion: '26.0.1',
        compatibleSdkVersion: '6.0.2(22)',
        runtimeOS: 'HarmonyOS',
      },
    ],
    buildModeSet: [
      { name: 'debug' },
      { name: 'release' },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: ['default'],
        },
      ],
    },
  ],
}
